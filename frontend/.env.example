# -----------------------------------------------------------------------------
# Patron - Frontend environment template
#
# Copy this file to `.env.local` and fill in your values.
# `.env.local` is git-ignored; this template is committed.
#
# WARNING: every VITE_* variable is bundled into the browser build and is
# publicly visible. Never put secrets, API keys, or credentials here.
# Secrets belong in the backend only.
# -----------------------------------------------------------------------------

# Base URL of the Patron backend API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Shown in the UI / useful for debugging which environment is running
VITE_APP_ENV=development
