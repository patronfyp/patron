# -----------------------------------------------------------------------------
# Patron - Backend environment template
#
# Copy this file to `.env` and fill in your values.
# `.env` is git-ignored; this template is committed.
#
# Unlike the frontend, values here are NOT exposed to the browser - this is
# where real secrets belong.
# -----------------------------------------------------------------------------

APP_NAME=Patron API
APP_ENV=development
DEBUG=true

# All routes are served under this prefix
API_V1_PREFIX=/api/v1

# Comma-separated list of origins allowed to call this API.
# 5173 is the Vite dev server.
CORS_ORIGINS=http://localhost:5173

# Used to sign JWT access/refresh tokens.
# Generate a real one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-me-with-a-generated-secret

# PostgreSQL connection string.
#   postgresql+asyncpg -> use SQLAlchemy's async driver
#   postgres:<password> -> local superuser; production uses a restricted role
#   localhost:5432      -> default PostgreSQL port
#   /patron             -> database name (create it with: psql -U postgres -c "CREATE DATABASE patron;")
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/patron

# -----------------------------------------------------------------------------
# LinkedIn OAuth - Module 1.1, the primary sign-in route
#
# Values come from the LinkedIn developer app:
#   https://www.linkedin.com/developers/apps -> Patron -> Auth tab
#
# The app uses the "Sign In with LinkedIn using OpenID Connect" product, which
# is self-serve. Its scopes are openid, profile and email - which give the
# user's LinkedIn id, name, picture and verified email, and nothing else.
# Headline, positions, education and skills need LinkedIn Partner Program
# approval and are not available to this project. See ADR 0011.
#
# The redirect URI must match the app's Authorized redirect URLs exactly -
# LinkedIn rejects even a trailing slash difference.
# -----------------------------------------------------------------------------
LINKEDIN_CLIENT_ID=your-linkedin-client-id
LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/auth/linkedin/callback
